{
  "name": "sistema-demandas",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS individual de gestao de demandas e prazos",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "nodemon server.js",
    "dev:web": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1",
    "android:sync": "npm run build && cap sync android",
    "db:migrate": "node scripts/migrar-banco.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "sass": "^1.93.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
