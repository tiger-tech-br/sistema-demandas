NODE_ENV=development
PORT=4000

# Banco exclusivo de desenvolvimento. Use os dados corretos no seu .env.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sistema_demandas
DATABASE_SSL=false

# Em producao com HTTPS, use NODE_ENV=production.
# Ajuste a confianca no proxy conforme sua hospedagem (ex.: um proxy = 1).
TRUST_PROXY_HOPS=0

# Links publicos recorrentes conferidos: R$ 35 mensal e R$ 350 anual.
# Deixe vazios para desabilitar a contratacao em um ambiente de teste.
PAGBANK_LINK_MENSAL=https://pag.ae/82ixDFWsJ
PAGBANK_LINK_ANUAL=https://pag.ae/82ixDhLCJ

# Origens adicionais autorizadas, separadas por virgula, se necessario.
# A origem do site e as origens padrao do Capacitor ja sao aceitas.
APP_ALLOWED_ORIGINS=

# URL publica confiavel usada nos links de e-mail; nunca e obtida do navegador.
APP_URL=http://localhost:4000/
# Verifique tigertech.dev.br e os registros DNS no Resend antes do envio.
# Em producao, use APP_URL=https://sistema-demandas-production.up.railway.app/
RESEND_API_KEY=
RESEND_FROM=Tiger Tech <nao-responda@tigertech.dev.br>
